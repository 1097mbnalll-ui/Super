{
  "appId": "sa.ohod.store",
  "appName": "متاجر أحد",
  "webDir": "www",
  "backgroundColor": "#F3F6F4",
  "server": {
    "androidScheme": "https",
    "allowNavigation": [
      "1097mbnalll-ui.github.io",
      "ohod-admin.1097mbnalll.workers.dev"
    ]
  },
  "ios": {
    "contentInset": "never",
    "scrollEnabled": true,
    "limitsNavigationsToAppBoundDomains": false,
    "allowsLinkPreview": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 800,
      "backgroundColor": "#0E9F7B",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "LIGHT",
      "backgroundColor": "#F3F6F4",
      "overlaysWebView": true
    },
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    },
    "SystemBars": {
      "insetsHandling": "css",
      "style": "LIGHT"
    }
  }
}
